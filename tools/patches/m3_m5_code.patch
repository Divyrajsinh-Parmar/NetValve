diff --git a/app/src/main/kotlin/dev/netvalve/sim/SimHttp.kt b/app/src/main/kotlin/dev/netvalve/sim/SimHttp.kt
new file mode 100644
index 0000000..684a831
--- /dev/null
+++ b/app/src/main/kotlin/dev/netvalve/sim/SimHttp.kt
@@ -0,0 +1,71 @@
+package dev.netvalve.sim
+
+import java.net.InetSocketAddress
+import java.net.Socket
+import java.net.URI
+import javax.net.ssl.HttpsURLConnection
+import javax.net.ssl.SSLSocket
+import javax.net.ssl.SSLSocketFactory
+
+/**
+ * Minimal HTTP/1.1 over a raw socket for the traffic simulator.
+ *
+ * Why not HttpURLConnection: the roadmap wants separate connections, plain HTTP/1.1, no reuse.
+ * A raw socket guarantees that: every call opens its own connection, sends `Connection: close`
+ * and never offers HTTP/2. Pure JDK classes, no Android imports.
+ */
+internal object SimHttp {
+
+    class Target(val secure: Boolean, val host: String, val port: Int, val pathAndQuery: String)
+
+    /** @throws IllegalArgumentException for anything but a valid http or https URL. */
+    fun parse(url: String): Target {
+        val uri = try {
+            URI(url.trim())
+        } catch (e: Exception) {
+            throw IllegalArgumentException("Not a valid URL: $url")
+        }
+        val scheme = uri.scheme?.lowercase()
+        require(scheme == "http" || scheme == "https") { "URL must start with http:// or https://" }
+        val host = uri.host
+        require(!host.isNullOrEmpty()) { "URL has no host: $url" }
+        val secure = scheme == "https"
+        val port = if (uri.port > 0) uri.port else if (secure) 443 else 80
+        val path = (uri.rawPath?.takeIf { it.isNotEmpty() } ?: "/") + (uri.rawQuery?.let { "?$it" } ?: "")
+        return Target(secure, host, port, path)
+    }
+
+    fun getRequest(t: Target): ByteArray =
+        ("GET ${t.pathAndQuery} HTTP/1.1\r\nHost: ${hostHeader(t)}\r\nUser-Agent: NetValve-Sim\r\n" +
+            "Accept: */*\r\nConnection: close\r\n\r\n").toByteArray(Charsets.US_ASCII)
+
+    fun postHeader(t: Target, contentLength: Long): ByteArray =
+        ("POST ${t.pathAndQuery} HTTP/1.1\r\nHost: ${hostHeader(t)}\r\nUser-Agent: NetValve-Sim\r\n" +
+            "Content-Type: application/octet-stream\r\nContent-Length: $contentLength\r\n" +
+            "Connection: close\r\n\r\n").toByteArray(Charsets.US_ASCII)
+
+    private fun hostHeader(t: Target): String {
+        val default = if (t.secure) 443 else 80
+        return if (t.port == default) t.host else "${t.host}:${t.port}"
+    }
+
+    /** Opens a NEW connection (TLS for https, with hostname check). The caller closes it. */
+    fun open(t: Target, connectTimeoutMs: Int = 10_000, readTimeoutMs: Int = 15_000): Socket {
+        val plain = Socket()
+        plain.tcpNoDelay = true
+        plain.connect(InetSocketAddress(t.host, t.port), connectTimeoutMs)
+        plain.soTimeout = readTimeoutMs
+        if (!t.secure) return plain
+        val ssl = (SSLSocketFactory.getDefault() as SSLSocketFactory).createSocket(plain, t.host, t.port, true) as SSLSocket
+        try {
+            ssl.soTimeout = readTimeoutMs
+            ssl.startHandshake()
+            val ok = HttpsURLConnection.getDefaultHostnameVerifier().verify(t.host, ssl.session)
+            if (!ok) throw javax.net.ssl.SSLPeerUnverifiedException("hostname ${t.host} not verified")
+        } catch (e: Exception) {
+            runCatching { ssl.close() }
+            throw e
+        }
+        return ssl
+    }
+}
diff --git a/app/src/main/kotlin/dev/netvalve/sim/TrafficSimulator.kt b/app/src/main/kotlin/dev/netvalve/sim/TrafficSimulator.kt
new file mode 100644
index 0000000..28428b9
--- /dev/null
+++ b/app/src/main/kotlin/dev/netvalve/sim/TrafficSimulator.kt
@@ -0,0 +1,183 @@
+package dev.netvalve.sim
+
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.isActive
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import java.io.IOException
+import java.net.Socket
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.atomic.AtomicInteger
+import java.util.concurrent.atomic.AtomicLong
+import kotlin.random.Random
+
+enum class SimMode { DOWN, UP, BOTH }
+
+/** Live numbers for the simulator screen. Rates are bytes per second over the last second. */
+data class SimStats(
+    val running: Boolean = false,
+    val mode: SimMode? = null,
+    val downBps: Long = 0,
+    val upBps: Long = 0,
+    val totalDown: Long = 0,
+    val totalUp: Long = 0,
+    val elapsedSec: Int = 0,
+    val errors: Int = 0,
+    val lastError: String? = null,
+)
+
+/**
+ * The "Low app" of the evaluation (roadmap M5): generates heavy traffic under NetValve's own UID,
+ * which the tier rules lock to Low.
+ *
+ * Down: [downloads] parallel GETs, each a separate HTTP/1.1 connection that is reopened when it ends.
+ * Up: [uploads] parallel POSTs of random bytes, each a separate connection.
+ * Stops by itself after the auto-stop time (0 = never) so a forgotten run cannot eat a data pack.
+ *
+ * Pure Kotlin plus coroutines: no Android imports, so it is tested on a JVM against a local server.
+ * It runs in [scope] (the app scope) so the load keeps going when the screen is left.
+ */
+class TrafficSimulator(
+    private val scope: CoroutineScope,
+    private val downloads: Int = DEFAULT_DOWNLOADS,
+    private val uploads: Int = DEFAULT_UPLOADS,
+) {
+    private val _stats = MutableStateFlow(SimStats())
+    val stats: StateFlow<SimStats> = _stats
+
+    private val downBytes = AtomicLong(0)
+    private val upBytes = AtomicLong(0)
+    private val errors = AtomicInteger(0)
+    @Volatile private var lastError: String? = null
+    @Volatile private var running = false
+    private var job: Job? = null
+    private val sockets: MutableSet<Socket> = ConcurrentHashMap.newKeySet()
+
+    /**
+     * @throws IllegalArgumentException when a needed URL is invalid (nothing is started then).
+     */
+    @Synchronized
+    fun start(mode: SimMode, downloadUrl: String, uploadUrl: String, autoStopSec: Int) {
+        val down = if (mode != SimMode.UP) SimHttp.parse(downloadUrl) else null
+        val up = if (mode != SimMode.DOWN) SimHttp.parse(uploadUrl) else null
+        stopInternal()
+
+        downBytes.set(0); upBytes.set(0); errors.set(0); lastError = null
+        running = true
+        _stats.value = SimStats(running = true, mode = mode)
+
+        job = scope.launch(Dispatchers.IO) {
+            if (down != null) repeat(downloads) { launch { downloadLoop(down) } }
+            if (up != null) repeat(uploads) { launch { uploadLoop(up) } }
+            sampleLoop(mode, autoStopSec)
+        }
+    }
+
+    @Synchronized
+    fun stop() {
+        stopInternal()
+        _stats.value = _stats.value.copy(running = false, downBps = 0, upBps = 0)
+    }
+
+    private fun stopInternal() {
+        running = false
+        job?.cancel()
+        job = null
+        // Blocking reads are not cancellable: closing the sockets makes them throw and end.
+        sockets.toList().forEach { runCatching { it.close() } }
+        sockets.clear()
+    }
+
+    private suspend fun sampleLoop(mode: SimMode, autoStopSec: Int) {
+        var lastDown = 0L
+        var lastUp = 0L
+        var seconds = 0
+        while (scope.isActive && running) {
+            delay(1_000)
+            seconds++
+            val d = downBytes.get()
+            val u = upBytes.get()
+            _stats.value = SimStats(
+                running = true, mode = mode,
+                downBps = d - lastDown, upBps = u - lastUp,
+                totalDown = d, totalUp = u,
+                elapsedSec = seconds, errors = errors.get(), lastError = lastError,
+            )
+            lastDown = d
+            lastUp = u
+            if (autoStopSec > 0 && seconds >= autoStopSec) {
+                stop()
+                return
+            }
+        }
+    }
+
+    private suspend fun downloadLoop(t: SimHttp.Target) {
+        val buf = ByteArray(BUFFER)
+        while (running) {
+            var s: Socket? = null
+            try {
+                s = SimHttp.open(t)
+                sockets.add(s)
+                s.getOutputStream().apply { write(SimHttp.getRequest(t)); flush() }
+                val input = s.getInputStream()
+                while (running) {
+                    val n = input.read(buf)
+                    if (n < 0) break
+                    downBytes.addAndGet(n.toLong())
+                }
+            } catch (e: IOException) {
+                if (running) noteError(e)
+            } finally {
+                s?.let { sockets.remove(it); runCatching { it.close() } }
+            }
+            if (running) delay(RETRY_DELAY_MS)
+        }
+    }
+
+    private suspend fun uploadLoop(t: SimHttp.Target) {
+        val chunk = ByteArray(BUFFER).also { Random.nextBytes(it) }
+        while (running) {
+            var s: Socket? = null
+            try {
+                s = SimHttp.open(t)
+                sockets.add(s)
+                val out = s.getOutputStream()
+                out.write(SimHttp.postHeader(t, UPLOAD_BODY_BYTES))
+                var sent = 0L
+                while (running && sent < UPLOAD_BODY_BYTES) {
+                    val n = minOf(chunk.size.toLong(), UPLOAD_BODY_BYTES - sent).toInt()
+                    out.write(chunk, 0, n)
+                    sent += n
+                    upBytes.addAndGet(n.toLong())
+                }
+                out.flush()
+            } catch (e: IOException) {
+                if (running) noteError(e)
+            } finally {
+                s?.let { sockets.remove(it); runCatching { it.close() } }
+            }
+            if (running) delay(RETRY_DELAY_MS)
+        }
+    }
+
+    private fun noteError(e: Exception) {
+        errors.incrementAndGet()
+        lastError = "${e.javaClass.simpleName}: ${e.message}"
+    }
+
+    companion object {
+        const val DEFAULT_DOWNLOADS = 3
+        const val DEFAULT_UPLOADS = 2
+        const val DEFAULT_DOWNLOAD_URL = "https://speed.cloudflare.com/__down?bytes=100000000"
+        const val DEFAULT_UPLOAD_URL = "https://speed.cloudflare.com/__up"
+        const val DEFAULT_AUTO_STOP_SEC = 60
+        private const val BUFFER = 16 * 1024
+        private const val UPLOAD_BODY_BYTES = 25L * 1024 * 1024
+        private const val RETRY_DELAY_MS = 500L
+    }
+}
